#!/usr/bin/env bash
# Hook Git Arvor partage entre worktrees : revue non bloquante apres commit.
# ARVOR_OPENCODE_AUTOREVIEW_V2
set -euo pipefail
root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$root" ]] || exit 0
sha="$(git rev-parse HEAD)"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || exit 0
worker="${XDG_DATA_HOME:-$HOME/.local/share}/arvor-opencode/opencode_auto_review_commit.sh"
[[ -f "$worker" ]] || exit 0
state="${XDG_STATE_HOME:-$HOME/.local/state}/arvor-opencode"
mkdir -p "$state"
chmod 700 "$state"
nohup bash "$worker" "$root" "$sha" >> "$state/hooks.log" 2>&1 </dev/null &
exit 0
