# Example only: copy to .env locally, never commit credentials.
# Use an accessible Qwen/llama.cpp instance; the WSL gateway address can differ.
LLM_BASE_URL=http://172.31.48.1:8081

# Generate separate unpredictable secrets of at least 32 characters each.
EDITORIAL_API_TOKEN=
EDITORIAL_WEB_PASSWORD=

# Dedicated UUIDs for the single private tenant and human actor.
EDITORIAL_TENANT_ID=
EDITORIAL_ACTOR_ID=

# Configure the PostgreSQL database actually used by the application.
PO_DATABASE_URL=

# Asynchronous editorial queue is disabled until a separate worker is installed.
# Enabling it without a worker leaves runs waiting in queued status.
EDITORIAL_ASYNC_ENABLED=false

# Opt-in only after exact-SHA delivery approval and a private existing bucket.
EDITORIAL_MEDIA_BACKEND=filesystem
# Persistent private directory: historical images and uncertain-upload recovery.
EDITORIAL_MEDIA_ROOT=
MEDIA_S3_ENDPOINT=https://127.0.0.1:9000
MEDIA_S3_BUCKET=editorial-artifacts


# Optional GitHub cockpit, private account, server-side token only.
EDITORIAL_GITHUB_READ_TOKEN=
EDITORIAL_GITHUB_REPOSITORY=richardyoann/saas-directeur-editorial
# Hide interactive OpenAPI endpoints unless in a trusted dev environment.
EDITORIAL_ENABLE_API_DOCS=false
# Studio is intentionally read-only for GitHub. Do not configure a write token here.

# NAME and NAME_FILE are mutually exclusive; both empty permits systemd LoadCredential.
EDITORIAL_API_TOKEN_FILE=
EDITORIAL_WEB_PASSWORD_FILE=
EDITORIAL_TENANT_ID_FILE=
EDITORIAL_ACTOR_ID_FILE=
PO_DATABASE_URL_FILE=
# Absolute WSL paths; the Docker service remaps these to /run/secrets.
# Application IAM identity only, never MinIO root credentials.
MEDIA_S3_ACCESS_KEY_FILE=/home/your-user/.config/arvor/secrets/media_s3_access_key
MEDIA_S3_SECRET_KEY_FILE=/home/your-user/.config/arvor/secrets/media_s3_secret_key
AWS_CA_BUNDLE=/absolute/path/to/.security-secrets/tls/ca.crt
EDITORIAL_GITHUB_READ_TOKEN_FILE=
# Docker Compose expects absolute host FILE paths only (never plaintext values).
ARVOR_POSTGRES_PASSWORD_FILE=
ARVOR_MINIO_ROOT_USER_FILE=
ARVOR_MINIO_ROOT_PASSWORD_FILE=
# Database name and username are nonsecret identifiers, not passwords.
ARVOR_POSTGRES_DB=editorial
ARVOR_POSTGRES_USER=editorial

# Optional API profile: native Linux/WSL Docker host networking required.
ARVOR_API_UID=1000
ARVOR_API_GID=1000
ARVOR_API_MEDIA_DIR=/absolute/path/to/private/media
# Existing MinIO /data/.tls certificates remain authoritative.
ARVOR_API_SECRETS_DIR=/absolute/path/to/application-only-secrets

# Image / voice / video chain (required for the 75 s production flow).
# Private sd.cpp image service reachable from the API; empty disables image generation.
IMAGE_BASE_URL=
ARVOR_IMAGE_TIMEOUT_SECONDS=
# Piper voice: binary on PATH (or absolute path) and an existing .onnx model; empty model disables voice.
ARVOR_PIPER_BIN=piper
ARVOR_PIPER_MODEL=
ARVOR_FFMPEG_BIN=ffmpeg
# Private scratch directory for voice/video rendering (empty = default temporary location).
ARVOR_MEDIA_WORK_DIR=

# Optional private MLflow observability (loopback URL only; opt-in).
ARVOR_MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
ARVOR_MLFLOW_SPOOL=
